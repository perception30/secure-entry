# npm run setup:cognito writes .env with the new pool's public identifiers.
OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_REPLACE
OIDC_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_REPLACE/.well-known/jwks.json
OIDC_AUDIENCE=https://secure-entry.example/api
OIDC_CLIENT_ID=REPLACE
COGNITO_DOMAIN=https://REPLACE.auth.us-east-1.amazoncognito.com
BACKEND_URL=http://127.0.0.1:3001
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
