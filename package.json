{
  "name": "secure-entry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "start:gateway": "node --env-file=.env dist/gateway/src/server.js",
    "start:backend": "node --env-file=.env dist/backend/src/server.js",
    "login": "node --env-file=.env scripts/login.mjs",
    "smoke": "node scripts/smoke.mjs",
    "setup:cognito": "python3 scripts/provision-cognito.py"
  },
  "dependencies": {
    "express": "5.2.1",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
